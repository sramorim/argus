# ARGUS — variáveis de ambiente.
# Copiar para .env (local) ou cadastrar no painel do Render (produção).
# NUNCA commitar o .env preenchido.

# ---------- obrigatórias em produção ----------

# Segredo do servidor. Sem isto (e com NODE_ENV=production) o servidor NÃO arranca.
# Define: a assinatura dos tokens de sessão e a chave AES-256-GCM das chaves BYOK.
# Gerar:  openssl rand -hex 32
# Se mudar: as sessões existentes caem e as chaves BYOK guardadas deixam de decifrar.
ARGUS_SECRET=

# Onde fica o ficheiro SQLite. Tem de ser um caminho ABSOLUTO no disco persistente.
# Local: apps/server/data/argus.db (caminho relativo aceite).
# Render: o disco é montado em /var/data →  ARGUS_DB=/var/data/argus.db
ARGUS_DB=

NODE_ENV=production

# ---------- cookies e sessão ----------

# true = cookie só por HTTPS (obrigatório em produção; prefixo __Host- é added automaticamente).
# false = só para desenvolvimento local em http://127.0.0.1
ARGUS_COOKIE_SECURE=true
ARGUS_COOKIE_SAMESITE=Lax
ARGUS_SESSION_DAYS=30

# ---------- rede ----------

# O Render injeta PORT automaticamente (10000 por omissão). Não é preciso definir.
# PORT=10000

# true = existe um proxy de confiança à frente (Render): o X-Forwarded-For é lido
# para o rate-limit. Só ativar se for verdade, senão o cliente falseia o próprio IP.
ARGUS_TRUST_PROXY=true

# Endereço público do ARGUS. Aparece no log de arranque e serve de referência.
ARGUS_PUBLIC_ORIGIN=https://argus.senhoramorim.com.br

# Origens extra autorizadas por CORS. VAZIO = nenhuma (mesma origem), que é o correto
# porque a app e a API são servidas no mesmo domínio. Nunca usar "*".
# ARGUS_ALLOWED_ORIGINS=https://exemplo.com

# Só se o build do frontend estiver noutro sítio. 'auto' descobre sozinho.
# ARGUS_WEB_DIST=apps/web/dist

# ---------- Apify (opcional) ----------

# Chave da conta Apify — SÓ backend. O servidor lê process.env.APIFY_API_TOKEN
# (fallback: APIFY_TOKEN) e nunca a devolve em findings, logs, respostas da API
# ou banco: o /api/health mostra o NOME da variável e o estado, nunca o valor.
# Sem esta variável a ferramenta APIFY responde NOT_CONFIGURED e não gasta nada.
#
# Gerar: Apify Console → Settings → API & Integrations → Create new token.
# Produção (Render): cadastrar como variável de ambiente/secret do serviço,
#   key = APIFY_API_TOKEN, valor = <chave> — o valor NUNCA vem para este ficheiro.
# Local: o servidor não carrega .env automaticamente, portanto exportar no
#   arranque, ex.: APIFY_API_TOKEN=<chave> ./run.sh start
# NUNCA commitar o valor: .env já está no .gitignore.
APIFY_API_TOKEN=

# ---------- DataLikers (opcional) ----------

# Chave da conta DataLikers — SÓ backend. O servidor lê
# process.env.DATALIKERS_API_KEY e nunca a devolve em findings, logs, URLs
# guardadas, respostas da API ou banco: o /api/health mostra o NOME da
# variável e o estado, nunca o valor. Os pedidos vão no header `x-access-key`
# (a URL que fica na proveniência é reconstruída sem a chave).
#
# Sem esta variável a ferramenta DATALIKERS responde NOT_CONFIGURED, a fase
# Social do plano de investigação fica BLOQUEADA com o motivo à vista, e o
# health mostra "DataLikers / NOT CONFIGURED" — não se gasta nada.
# Com a variável, cada pedido desconta do saldo da conta DataLikers.
#
# Criar em: https://datalikers.com/login → Cache API (https://datalikers.com/cache-api)
# Produção (Render): cadastrar como variável de ambiente/secret do serviço,
#   key = DATALIKERS_API_KEY, valor = <chave> — o valor NUNCA vem para este ficheiro.
# Local: exportar no arranque, ex.: DATALIKERS_API_KEY=<chave> ./run.sh start
# NUNCA commitar o valor: .env já está no .gitignore.
DATALIKERS_API_KEY=

# ---------- development (opcional) ----------

# limite de tentativas de login por IP na janela
# ARGUS_AUTH_MAX=10
# ARGUS_AUTH_WINDOW_MIN=15

# ---------------------------------------------------------------------------
# ADMINISTRADOR
#
# Lista de emails separados por vírgula, SEM espaço. Quem se registar com um
# destes entra como admin no primeiro login e recebe `role='admin'`. É o
# caminho mais simples para não precisar de SSH para promover a sua conta.
# O email vai no Render (Dashboard → Environment), não no código: um endereço
# pessoal escrito num ficheiro do repositório é um endereço pessoal público.
# ---------------------------------------------------------------------------
ARGUS_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# CHAVE PIX (pagamento do plano Pro)
#
# NÃO é um segredo: é mostrada ao cliente na tela de Planos, com botão de
# copiar e QR code, para ele pagar. Vai no ambiente — e nunca escrita à mão no
# frontend, que é a forma mais rápida de cobrar a pessoa errada no dia em que
# a chave mudar.
# O valor de exemplo abaixo é a chave de teste do banco; troque pela sua.
# ---------------------------------------------------------------------------
PIX_KEY=
