# ARGUS — variáveis de ambiente.
# Copiar para .env (local) ou cadastrar no painel do Render (produção).
# NUNCA commitar o .env preenchido.

# ---------- obrigatórias em produção ----------

# Segredo do servidor. Sem isto (e com NODE_ENV=production) o servidor NÃO arranca.
# Define: a assinatura dos tokens de sessão e a chave AES-256-GCM das chaves BYOK.
# Gerar:  openssl rand -hex 32
# Se mudar: as sessões existentes caem e as chaves BYOK guardadas deixam de decifrar.
ARGUS_SECRET=

# Onde fica o ficheiro SQLite. Tem de ser um caminho ABSOLUTO no disco persistente.
# Local: apps/server/data/argus.db (caminho relativo aceite).
# Render: o disco é montado em /var/data →  ARGUS_DB=/var/data/argus.db
ARGUS_DB=

NODE_ENV=production

# ---------- cookies e sessão ----------

# true = cookie só por HTTPS (obrigatório em produção; prefixo __Host- é added automaticamente).
# false = só para desenvolvimento local em http://127.0.0.1
ARGUS_COOKIE_SECURE=true
ARGUS_COOKIE_SAMESITE=Lax
ARGUS_SESSION_DAYS=30

# ---------- rede ----------

# O Render injeta PORT automaticamente (10000 por omissão). Não é preciso definir.
# PORT=10000

# true = existe um proxy de confiança à frente (Render): o X-Forwarded-For é lido
# para o rate-limit. Só ativar se for verdade, senão o cliente falseia o próprio IP.
ARGUS_TRUST_PROXY=true

# Endereço público do ARGUS. Aparece no log de arranque e serve de referência.
ARGUS_PUBLIC_ORIGIN=https://argus.senhoramorim.com.br

# Origens extra autorizadas por CORS. VAZIO = nenhuma (mesma origem), que é o correto
# porque a app e a API são servidas no mesmo domínio. Nunca usar "*".
# ARGUS_ALLOWED_ORIGINS=https://exemplo.com

# Só se o build do frontend estiver noutro sítio. 'auto' descobre sozinho.
# ARGUS_WEB_DIST=apps/web/dist

# ---------- development (opcional) ----------

# limite de tentativas de login por IP na janela
# ARGUS_AUTH_MAX=10
# ARGUS_AUTH_WINDOW_MIN=15
