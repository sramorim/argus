{
  "name": "argus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARGUS — plataforma OSINT de fontes abertas: resultados reais, proveniencia obrigatoria, mobile-first",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@argus/server",
    "dev:web": "npm run dev --workspace=@argus/web",
    "build": "npm run build --workspace=@argus/web",
    "start": "npm run start --workspace=@argus/server",
    "test": "npm run test --workspace=@argus/server && npm run test --workspace=@argus/web",
    "test:unit": "npm run test:unit --workspace=@argus/server",
    "test:api": "npm run test:api --workspace=@argus/server",
    "test:ui": "npm run test --workspace=@argus/web",
    "test:prod": "npm run test:prod --workspace=@argus/server",
    "test:audit": "npm run test:audit --workspace=@argus/server",
    "test:all": "npm run test:all --workspace=@argus/server && npm run test --workspace=@argus/web",
    "typecheck": "node scripts/typecheck.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "framer-motion": "^13.5.0",
    "gsap": "^3.15.0"
  }
}
