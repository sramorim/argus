{
  "name": "@probe/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node test/security.test.ts && node test/parsers.test.ts",
    "test:api": "node test/api.test.ts",
    "test:prod": "node test/smoke-prod.ts",
    "test:audit": "node test/audit-tools.ts",
    "test:all": "npm run test:unit && npm run test:api && npm run test:prod"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/jpeg-js": "^0.3.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.2"
  }
}
